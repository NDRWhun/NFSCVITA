// Road (WORLDREFLECT dryroad and raining_on_road, shader 2, vs_2_0). Registers: WorldViewProj c0-c3, cvFogValue c4,
// cfFogEnable c5; pixel registers: cfSurfaceReflection p0, cavWorldHeadlightDirection p1,
// cavWorldHeadlightUpDirection p2, cavWorldHeadlightPosition p3. Outputs: twice the vertex colour raised to 1.3,
// the reflection strength (a hashed sparkle of the position, 3 frac^2, times p0.x), the fog (uFog: colour,
// enable), the texture coordinate, the reflection's projective screen coordinates, the vector to the headlight
// (raised one unit) and its dot products with the headlight direction, side and up, and the tangent frame.

// The lit instruction's z: x > 0 and y > 0 ? y^w (w clamped to +-127.9961) : 0.
float litZ(float x, float y, float w)
{
#ifdef LIT_BRANCH
    return x > 0.0 && y > 0.0 ? pow(y, clamp(w, -127.9961, 127.9961)) : 0.0;
#else
    // The power computed for every vertex and selected: no branch, so the program runs in parallel mode.
    float p = exp2(clamp(w, -127.9961, 127.9961) * log2(abs(y)));
    return x > 0.0 && y > 0.0 ? p : 0.0;
#endif
}

void main(
    float4 aPosition,
    float3 aNormal,
    float4 aColor,
    float2 aTex0,
    float4 aTangent,
    uniform float4 uC[7],
    uniform float4 uP[4],
    uniform float4 uFog,
    float4 out vPosition : POSITION,
    float4 out vColor : COLOR0,
    float4 out vColor1 : COLOR1,
    float2 out vTex0 : TEXCOORD0,
    float3 out vTex1 : TEXCOORD1,
    float3 out vTex2 : TEXCOORD2,
    half3 out vTex3 : TEXCOORD3_HALF,
    half3 out vTex4 : TEXCOORD4_HALF,
    half3 out vTex5 : TEXCOORD5_HALF,
    half3 out vTex6 : TEXCOORD6_HALF)
{
    float4 color = aColor.zyxw;
    float4 h = float4(dot(aPosition, uC[0]), dot(aPosition, uC[1]), dot(aPosition, uC[2]), dot(aPosition, uC[3]));
    vPosition = h;

    // Sparkle: the fraction of 2^(3.20 * (3 +- frac(4 |x|) / 4)) * 2^(2.83 * (3 +- frac(4 |y|) / 4)).
    float2 quarter = aPosition.xy >= 0.0 ? float2(0.25) : float2(-0.25);
    float2 e = (quarter * frac(aPosition.xy / quarter) + 3.0) * float2(3.20367098, 2.83257604);
    float sparkle = frac(exp2(e.x) * exp2(e.y));
    float3 raised = float3(litZ(color.x, color.x, 1.29999995), litZ(color.y, color.y, 1.29999995),
                           litZ(color.z, color.z, 1.29999995));
    vColor = saturate(float4(raised * 2.0, (sparkle * sparkle * 3.0) * uP[0].x));

    // Fog: 1 - cfFogEnable * fog.z * (1 - saturate((fog.x - z) * fog.y))^fog.w.
    float g = 1.0 - saturate((uC[4].x - h.z) * uC[4].y);
    float haze = saturate((litZ(g, g, uC[4].w) * uC[4].z) * uC[5].x) * uFog.w;
    vColor1 = float4(uFog.rgb * haze, 1.0 - haze);

    vTex0 = aTex0;
    vTex1 = float3((h.x + h.w) * 0.5, (h.w - h.y) * 0.5, h.w);
    float3 l = uP[3].xyz + float3(0.0, 0.0, 1.0) - aPosition.xyz;
    vTex2 = l;
    float3 side = cross(uP[1].xyz, uP[2].xyz);
    vTex3 = half3(dot(l, -uP[1].xyz), dot(l, -side), dot(l, uP[2].xyz));
    vTex4 = half3(aTangent.xyz);
    vTex5 = half3(cross(aNormal, aTangent.xyz) * aTangent.w);
    vTex6 = half3(aNormal);
}
