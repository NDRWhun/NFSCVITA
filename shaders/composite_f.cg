// Motion blur composite (VISUALTREATMENT composite_blur, ps_3_0). Register: cvBlurParams c0. The blur (sampler 1)
// over the scene (sampler 0) by the blur's alpha times c0.x; alpha the scene's.

float4 main(
    float2 vTex0 : TEXCOORD0,
    uniform sampler2D uTex0,
    uniform sampler2D uTex1,
    uniform float4 uC[1],
    uniform float4 uAlphaTest) : COLOR
{
    half4 blur = tex2D<half4>(uTex1, vTex0);
    half4 c = tex2D<half4>(uTex0, vTex0);
    c.rgb = lerp(c.rgb, blur.rgb, blur.a * half(uC[0].x));
#ifdef ATEST
    if (half(uAlphaTest.x) * c.a < half(uAlphaTest.y))
        discard;
#endif
    return c;
}
