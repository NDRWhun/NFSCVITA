// CombineReflectionColourAndHeadlightAlpha (ps_2_0): colour of sampler 0, alpha the luminance of sampler 1.

float4 main(
    float2 vTex0 : TEXCOORD0,
    uniform sampler2D uTex0,
    uniform sampler2D uTex1,
    uniform float4 uAlphaTest) : COLOR
{
    half4 r1 = tex2D<half4>(uTex1, vTex0);
    half4 c = tex2D<half4>(uTex0, vTex0);
    c.a = dot(r1.rgb, half3(0.212500006, 0.715399981, 0.0720999986));
#ifdef ATEST
    if (uAlphaTest.x * saturate(c.a) < uAlphaTest.y)
        discard;
#endif
    return c;
}
