// Picture-in-picture and rear-view mirror at shader 1 (RVMPIP pip and rvm, ps_1_1), without the colour cube. PIP:
// the view (sampler 0, coordinate 0) with the opacity map's alpha (sampler 1, coordinate 1). RVM: the view (sampler
// 1, coordinate 1) with the opacity map's alpha (sampler 0, coordinate 0) times the vertex colour's blue.

float4 main(
#ifdef RVM
    half4 vColor : COLOR0,
#endif
    float2 vTex0 : TEXCOORD0,
    float2 vTex1 : TEXCOORD1,
    uniform sampler2D uTex0,
    uniform sampler2D uTex1,
    uniform float4 uAlphaTest) : COLOR
{
    half4 t0 = tex2D<half4>(uTex0, vTex0);
    half4 t1 = tex2D<half4>(uTex1, vTex1);
#ifdef RVM
    half4 c = half4(t1.rgb, t0.a * vColor.b);
#else
    half4 c = half4(t0.rgb, t1.a);
#endif
#ifdef ATEST
    if (half(uAlphaTest.x) * c.a < half(uAlphaTest.y))
        discard;
#endif
    return c;
}
