// Screen pass-through (ps_2_0): the texel of sampler 0.

float4 main(
    float2 vTex0 : TEXCOORD0,
    uniform sampler2D uTex0,
    uniform float4 uAlphaTest) : COLOR
{
    half4 c = tex2D<half4>(uTex0, vTex0);
#ifdef ATEST
    if (uAlphaTest.x * saturate(c.a) < uAlphaTest.y)
        discard;
#endif
    return c;
}
