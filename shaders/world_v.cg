// World (shader 2, vs_2_0). Registers: WorldViewProj c0-c3, cmWorldMat c4-c7, cvFogValue c8, cfFogEnable c9,
// cvVertexPowerBrightness c10, cvTextureOffset c11, cfMipMapBias c12 (applied as the sampler's bias); pixel
// registers: cmWorldMatTranspose p0-p2, cfFogEnable p3 (headlight scale), cavWorldHeadlightDirection p4,
// cavWorldHeadlightUpDirection p5, cavWorldHeadlightPosition p6. Outputs: the vertex colour raised to c10.x and
// scaled by c10.y, the fog (uFog: colour, enable), the texture coordinate, the vector to the headlight with the
// scaled facing term, and its dot products with the headlight direction and up direction (linear in the position).

// The lit instruction's z: x > 0 and y > 0 ? y^w (w clamped to +-127.9961) : 0.
float litZ(float x, float y, float w)
{
#ifdef LIT_BRANCH
    return x > 0.0 && y > 0.0 ? pow(y, clamp(w, -127.9961, 127.9961)) : 0.0;
#else
    // The power computed for every vertex and selected: no branch, so the program runs in parallel mode.
    float p = exp2(clamp(w, -127.9961, 127.9961) * log2(abs(y)));
    return x > 0.0 && y > 0.0 ? p : 0.0;
#endif
}

void main(
    float4 aPosition,
    float4 aColor,
    float2 aTex0,
    float3 aNormal,
    uniform float4 uC[13],
    uniform float4 uP[7],
    uniform float4 uFog,
    float4 out vPosition : POSITION,
    float4 out vColor : COLOR0,
    float4 out vColor1 : COLOR1,
    float2 out vTex0 : TEXCOORD0,
    float4 out vTex1 : TEXCOORD1,
    float2 out vTex2 : TEXCOORD2)
{
    float4 color = aColor.zyxw;
    float z = dot(aPosition, uC[2]);
    vPosition = float4(dot(aPosition, uC[0]), dot(aPosition, uC[1]), z, dot(aPosition, uC[3]));
    float power = uC[10].x;
    float3 raised = float3(litZ(color.x, color.x, power), litZ(color.y, color.y, power),
                           litZ(color.z, color.z, power));
    vColor = saturate(float4(raised * uC[10].y, color.w));

    // Fog: 1 - cfFogEnable * fog.z * (1 - saturate((fog.x - z) * fog.y))^fog.w.
    float g = 1.0 - saturate((uC[8].x - z) * uC[8].y);
    float haze = saturate((litZ(g, g, uC[8].w) * uC[8].z) * uC[9].x) * uFog.w;
    vColor1 = float4(uFog.rgb * haze, 1.0 - haze);
    vTex0 = aTex0 + uC[11].xy;

    // Headlight: the world normal and the brighter facing term of upward normals fold into one dot product.
    float3 world = float3(dot(uC[4], aPosition), dot(uC[5], aPosition), dot(uC[6], aPosition));
    float3 l = uP[6].xyz - world;
    float3 n = uP[0].xyz * aNormal.x + uP[1].xyz * aNormal.y + uP[2].xyz * aNormal.z;
    float up = pow(saturate(aNormal.z), 14.0) * 2.0 + 1.0;
    vTex1 = float4(l, dot(l, n) * (up * uP[3].x));
    vTex2 = float2(dot(l, -uP[4].xyz), dot(l, uP[5].xyz));
}
