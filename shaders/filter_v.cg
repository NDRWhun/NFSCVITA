// Filter (vs_1_1): position as given, four texture coordinates.

void main(
    float4 aPosition,
    float2 aTex0,
    float2 aTex1,
    float2 aTex2,
    float2 aTex3,
    float4 out vPosition : POSITION,
    float2 out vTex0 : TEXCOORD0,
    float2 out vTex1 : TEXCOORD1,
    float2 out vTex2 : TEXCOORD2,
    float2 out vTex3 : TEXCOORD3)
{
    vPosition = aPosition;
    vTex0 = aTex0;
    vTex1 = aTex1;
    vTex2 = aTex2;
    vTex3 = aTex3;
}
